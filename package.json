{
  "name": "nexus",
  "version": "0.3.0",
  "description": "Nexus — a Windows command center for AI: discover and control local (Ollama) and cloud models across your WiFi/LAN, orchestrate them on projects, and talk to Jarvis.",
  "main": "./out/main/index.js",
  "author": "breadisthebestfr-cell",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "mock": "tsx scripts/mock-ollama.ts",
    "discover": "tsx scripts/discover-cli.ts",
    "mcp": "tsx src/mcp/index.ts",
    "continuous": "tsx scripts/continuous-cli.ts",
    "bot": "tsx scripts/discord-bot.ts",
    "notify:test": "tsx scripts/notify-test.ts",
    "dist": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "electron-store": "^8.2.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "discord.js": "^14.27.0",
    "electron": "^31.1.0",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^2.0.0"
  }
}
