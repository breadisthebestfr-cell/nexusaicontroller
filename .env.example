# LocalAIConnection environment variables (for the headless CLIs, MCP server, and Discord bot).
# Copy to a private file and fill in — NEVER commit real tokens/URLs. These are only needed for the
# command-line tools; the desktop app configures the same things in its Settings tab instead.

# --- Discovery (used by the MCP server, continuous CLI, and Discord bot) ---
# Comma-separated pinned Ollama hosts, e.g. "192.168.1.20:11434,192.168.1.30:11434".
LOCALAI_OLLAMA_HOSTS=
# Set to 0 to disable the LAN sweep and use only pinned hosts + localhost.
LOCALAI_SCAN=1
# Discovery cache lifetime in ms (MCP server).
LOCALAI_CACHE_TTL_MS=30000

# --- Discord notifications (webhook) ---
# Incoming webhook URL from your Discord channel (Edit Channel -> Integrations -> Webhooks).
LOCALAI_DISCORD_WEBHOOK=
# Your Discord user ID, to actually @-mention/ping you (Developer Mode -> Copy User ID).
LOCALAI_DISCORD_MENTION_USER_ID=

# --- Discord control bot (npm run bot) ---
# Bot token from https://discord.com/developers/applications (keep secret!).
LOCALAI_DISCORD_TOKEN=
# Restrict the bot to one channel (right-click channel -> Copy ID).
LOCALAI_DISCORD_CHANNEL_ID=

# --- Continuous CLI / bot: the project folder the AIs work in ---
LOCALAI_PROJECT=
# Optional continuous tuning (CLI):
LOCALAI_MAX_CYCLES=5
LOCALAI_CYCLE_DELAY_MS=0

# --- Run history storage dir (optional; defaults to the app's userData dir) ---
LOCALAI_RUNS_DIR=
